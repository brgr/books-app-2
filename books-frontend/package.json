{
  "name": "books-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l ${PORT:-4173}",
    "heroku-postbuild": "npm run build",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.18.1",
    "idb": "^8.0.3",
    "marked": "^18.0.2",
    "serve": "^14.2.5",
    "sortablejs": "^1.15.2",
    "vue": "^3.5.22",
    "vue-router": "^5.1.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.0.2",
    "prettier": "3.9.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.1.0"
  }
}
